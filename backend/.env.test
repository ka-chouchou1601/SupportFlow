# Variables d'environnement pour l'environnement de test PHPUnit.
# Ce fichier est chargé automatiquement par tests/bootstrap.php en environnement "test".
# Il surcharge les valeurs de .env sans jamais modifier la base de développement.

KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base de données dédiée aux tests — séparée de la base de développement pour éviter
# tout écrasement accidentel des données dev lors de la suite de tests.
# Pointe sur supportflow_test dans le même conteneur MySQL Docker.
# En CI, remplacer "127.0.0.1" par l'hôte du service MySQL de la pipeline.
# doctrine.yaml ajoute automatiquement le suffixe "_test" au nom de la base en environnement test
# (voir config/packages/doctrine.yaml : dbname_suffix: '_test').
# La base effective sera donc : supportflow_db_test
# On utilise 127.0.0.1 (port Docker exposé) car .env.local n'est PAS chargé en mode test.
DATABASE_URL="mysql://supportflow:password@127.0.0.1:3306/supportflow_db?serverVersion=8.0"
